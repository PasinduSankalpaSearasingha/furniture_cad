# Shared deployment: replace this with a long random hexadecimal password.
POSTGRES_PASSWORD=replace_with_a_random_hex_secret
# Keep loopback for a reverse proxy on the same host. Set to 0.0.0.0 only when
# the EC2 security group/firewall is configured to allow the published port.
APP_BIND_ADDRESS=127.0.0.1
# Local development defaults to SQLite and private artifacts in outputs.
# DATABASE_URL=postgresql+psycopg://furniture:YOUR_HEX_SECRET@localhost:5432/furniture
# REDIS_URL=redis://localhost:6379/0
# STORAGE_ROOT=outputs

# Direct localhost only: set LOCAL_WORKSPACE=1 and JOB_EXECUTOR=local.
# Shared deployments use LOCAL_WORKSPACE=0 and JOB_EXECUTOR=celery.
LOCAL_WORKSPACE=0
# JOB_EXECUTOR=local
# Keep native CAD computations outside the web server so the UI stays responsive.
LOCAL_WORKFLOW_PROCESS=1

# Photo analysis and CAD planning require a valid backend API key.
# Enable AI after configuring the key. Never expose it in frontend variables.
AI_ENABLED=0
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=90
# Responses API: submit once, save the response ID and poll until complete.
OPENAI_BACKGROUND_MODE=1
OPENAI_POLL_INTERVAL_SECONDS=2
AI_MAX_OUTPUT_TOKENS=6000
AI_PHOTO_MAX_OUTPUT_TOKENS=28000
AI_PHOTO_TIMEOUT_SECONDS=600
AI_PHOTO_REASONING_EFFORT=medium
AI_FURNITURE_BUDGET_USD=2.00

# Local native CAD optimization; runs only with quantitative API evidence.
CAD_OPTIMIZER_ENABLED=1
CAD_OPTIMIZER_MODE=balanced
CAD_OPTIMIZER_MAX_SECONDS=600
CAD_FINAL_CORRECTION_ENABLED=1

# Advanced specialist overrides; the central reasoning model takes priority.
# OPENAI_VISION_MODEL=
# OPENAI_DESIGN_MODEL=
# OPENAI_REVIEW_MODEL=
# OPENAI_LIVE_TESTS=1 enables opt-in tests that incur real provider charges.
# The photo-to-CAD workspace needs no image-generation model or Blender.

# Optional: isolated native FreeCAD drawings for a local Docker-enabled worker.
# Build first: docker build -f tools/techdraw/Dockerfile -t fiske-techdraw:0.20.2 .
# TECHDRAW_DOCKER_IMAGE=fiske-techdraw:0.20.2
TECHDRAW_TIMEOUT_SECONDS=180
OPENAI_PHOTO_DESIGN_MODEL=gpt-6.1-sol
OPENAI_PHOTO_REVIEW_MODEL=gpt-6.1-sol

# Native editable CAD exports (FreeCAD's isolated embedded Python, not the app .venv).
# App dependencies and regeneration always run inside the project's .venv.
# FREECAD_PYTHON=C:/Program Files/FreeCAD 1.1/bin/python.exe
# Recognition has a hard limit of two Sol 6.1 generation requests per job.
# Numerical fitting and manual CAD revisions use zero AI requests.
# Optional installed local segmentation adapter: JSON argv, followed by normalized mesh and output JSON paths.
# FURNITURE_SEGMENTATION_COMMAND=["D:/models/.venv/Scripts/python.exe","D:/models/furniture_adapter.py"]
# Enable only after reviewing code, checkpoints and all transitive licenses.
FURNITURE_SEGMENTATION_LICENSE_ACCEPTED=false
